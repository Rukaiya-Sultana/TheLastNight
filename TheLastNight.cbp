<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TheLastNight" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Option extended_obj_names="1" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/TheLastNight" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/TheLastNight" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-Wall" />
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-DFREEGLUT_STATIC" />
			<!-- Build FreeGLUT from the vendored 3.6.0 source with the same
			     compiler architecture as the game.  The former prebuilt .a was
			     32-bit while modern Code::Blocks MinGW is normally 64-bit. -->
			<Add option="-DFREEGLUT_BUILDING_LIB" />
			<!-- Keep the WinXP API level and FreeGLUT's XParseGeometry shim. -->
			<Add option="-D_WIN32_WINNT=0x0501" />
			<Add option="-DNEED_XPARSEGEOMETRY_IMPL" />
			<!-- This game does not use a 3Dconnexion Spaceball. The Windows
			     no-device stubs are built; the optional raw-input backend is not. -->
			<Add option="-DFREEGLUT_DISABLE_SPACEBALL" />
			<Add directory="vendor/freeglut/include" />
			<Add directory="vendor/freeglut-3.6.0/include" />
			<Add directory="vendor/freeglut-3.6.0/src" />
		</Compiler>
		<Linker>
			<Add library="opengl32" />
			<Add library="glu32" />
			<Add library="gdi32" />
			<Add library="winmm" />
			<Add library="user32" />
			<Add library="kernel32" />
		</Linker>
		<Unit filename="Basement.cpp" />
		<Unit filename="Basement.h" />
		<Unit filename="Audio.cpp" />
		<Unit filename="Audio.h" />
		<Unit filename="Camera.cpp" />
		<Unit filename="Camera.h" />
